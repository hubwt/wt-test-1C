<?xml version="1.0" encoding="UTF-8"?>
<DataCompositionSchema xmlns="http://v8.1c.ru/8.1/data-composition-system/schema" xmlns:dcscom="http://v8.1c.ru/8.1/data-composition-system/common" xmlns:dcscor="http://v8.1c.ru/8.1/data-composition-system/core" xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings" xmlns:v8="http://v8.1c.ru/8.1/data/core" xmlns:v8ui="http://v8.1c.ru/8.1/data/ui" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<dataSource>
		<name>ИсточникДанных1</name>
		<dataSourceType>Local</dataSourceType>
	</dataSource>
	<dataSet xsi:type="DataSetQuery">
		<name>НаборДанных1</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>ИндКод</dataPath>
			<field>ИндКод</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Номенклатура</dataPath>
			<field>Номенклатура</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ДатаВосстановления</dataPath>
			<field>ДатаВосстановления</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>КоличествоДней</dataPath>
			<field>КоличествоДней</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Количество дней</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ДатаРеализации</dataPath>
			<field>ДатаРеализации</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Дата реализации</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Количество</dataPath>
			<field>Количество</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Количество</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ЦенаДетали</dataPath>
			<field>ЦенаДетали</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Цена детали</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>МестоХранения</dataPath>
			<field>МестоХранения</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Место хранения</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ЦенаРеализации</dataPath>
			<field>ЦенаРеализации</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Цена реализации</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Заказчик</dataPath>
			<field>Заказчик</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Заказчик</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Себестоимость</dataPath>
			<field>Себестоимость</field>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	Рас_КомплектовкаНоменклатураСписок.Ссылка КАК Ссылка,
	СУММА(Рас_КомплектовкаНоменклатураСписок.ЦенаДетали) КАК ЦенаДетали
ПОМЕСТИТЬ ВТ_Расходники
ИЗ
	Документ.Рас_Комплектовка.НоменклатураСписок КАК Рас_КомплектовкаНоменклатураСписок
ГДЕ
	Рас_КомплектовкаНоменклатураСписок.Ссылка.Дата МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания
	И Рас_КомплектовкаНоменклатураСписок.Ссылка.Инкод &lt;&gt; ЗНАЧЕНИЕ(Справочник.ИндКод.ПустаяСсылка)

СГРУППИРОВАТЬ ПО
	Рас_КомплектовкаНоменклатураСписок.Ссылка
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	Рас_КомплектовкаРаботыСписок.Ссылка КАК Ссылка,
	СУММА(Рас_КомплектовкаРаботыСписок.Сумма) КАК Сумма
ПОМЕСТИТЬ ВТ_СуммаРаботы
ИЗ
	Документ.Рас_Комплектовка.РаботыСписок КАК Рас_КомплектовкаРаботыСписок
ГДЕ
	Рас_КомплектовкаРаботыСписок.Ссылка.Дата МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания
	И Рас_КомплектовкаРаботыСписок.Ссылка.Инкод &lt;&gt; ЗНАЧЕНИЕ(Справочник.ИндКод.ПустаяСсылка)

СГРУППИРОВАТЬ ПО
	Рас_КомплектовкаРаботыСписок.Ссылка
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	Рас_Комплектовка.Инкод КАК ИндКод,
	Рас_Комплектовка.Инкод.Владелец КАК Номенклатура,
	Рас_Комплектовка.Дата КАК ДатаВосстановления,
	Рас_Комплектовка.Номенклатура.РекомендованаяЦена КАК НоменклатураРекомендованаяЦена,
	ВТ_СуммаРаботы.Сумма КАК СуммаРабот,
	ВТ_СуммаРаботы.Сумма * 0.4 КАК ДиминБашляй,
	ВТ_СуммаРаботы.Сумма + ВТ_Расходники.ЦенаДетали + ВТ_СуммаРаботы.Сумма * 0.4 КАК Себестоимость
ПОМЕСТИТЬ ВТ_ВосстановленныеДетали
ИЗ
	ВТ_СуммаРаботы КАК ВТ_СуммаРаботы
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Рас_Комплектовка КАК Рас_Комплектовка
		ПО ВТ_СуммаРаботы.Ссылка = Рас_Комплектовка.Ссылка
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Расходники КАК ВТ_Расходники
		ПО (Рас_Комплектовка.Ссылка = ВТ_Расходники.Ссылка)
ГДЕ
	Рас_Комплектовка.Инкод &lt;&gt; ЗНАЧЕНИЕ(Справочник.ИндКод.ПустаяСсылка)
	И Рас_Комплектовка.Дата МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания

ИНДЕКСИРОВАТЬ ПО
	ИндКод
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ЗаказНарядТовары.Ссылка КАК Ссылка,
	ЗаказНарядТовары.Партия КАК Партия,
	ЗаказНарядТовары.Цена КАК Цена,
	ЗаказНарядТовары.Ссылка.Дата КАК ДатаУстановки,
	ЗаказНарядТовары.Ссылка.Клиент КАК Клиент
ПОМЕСТИТЬ ВТ_ЗаказНаряд
ИЗ
	Документ.ЗаказНаряд.Товары КАК ЗаказНарядТовары
ГДЕ
	ЗаказНарядТовары.Партия В
			(ВЫБРАТЬ
				ВТ_ВосстановленныеДетали.ИндКод
			ИЗ
				ВТ_ВосстановленныеДетали КАК ВТ_ВосстановленныеДетали)
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ПродажаЗапчастейТаблица.Партия КАК Партия,
	ПродажаЗапчастейТаблица.ДатаВыдачи КАК ДатаПродажи,
	ПродажаЗапчастейТаблица.Цена КАК Цена,
	ПродажаЗапчастейТаблица.Ссылка.Клиент КАК Заказчик
ПОМЕСТИТЬ ВТ_ПроданныеДетали
ИЗ
	Документ.ПродажаЗапчастей.Таблица КАК ПродажаЗапчастейТаблица
ГДЕ
	ПродажаЗапчастейТаблица.Партия В
			(ВЫБРАТЬ
				ВТ_ВосстановленныеДетали.ИндКод
			ИЗ
				ВТ_ВосстановленныеДетали КАК ВТ_ВосстановленныеДетали)

ИНДЕКСИРОВАТЬ ПО
	Партия
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_ВосстановленныеДетали.ИндКод КАК ИндКод,
	ВТ_ВосстановленныеДетали.Номенклатура КАК Номенклатура,
	ВТ_ВосстановленныеДетали.ДатаВосстановления КАК ДатаВосстановления,
	ВЫБОР
		КОГДА ВТ_ПроданныеДетали.ДатаПродажи ЕСТЬ NULL
				ИЛИ ВТ_ПроданныеДетали.ДатаПродажи = ДАТАВРЕМЯ(1, 1, 1)
			ТОГДА ВЫБОР
					КОГДА ВТ_ЗаказНаряд.ДатаУстановки ЕСТЬ NULL
							ИЛИ ВТ_ЗаказНаряд.ДатаУстановки = ДАТАВРЕМЯ(1, 1, 1)
						ТОГДА "Не реализована"
					ИНАЧЕ ВТ_ЗаказНаряд.ДатаУстановки
				КОНЕЦ
		ИНАЧЕ ВТ_ПроданныеДетали.ДатаПродажи
	КОНЕЦ КАК ДатаРеализации,
	ВЫБОР
		КОГДА ВТ_ПроданныеДетали.ДатаПродажи ЕСТЬ NULL
				ИЛИ ВТ_ПроданныеДетали.ДатаПродажи = ДАТАВРЕМЯ(1, 1, 1)
			ТОГДА ВЫБОР
					КОГДА РАЗНОСТЬДАТ(ВТ_ВосстановленныеДетали.ДатаВосстановления, &amp;ТекДата, ДЕНЬ) = 0
						ТОГДА 1
					ИНАЧЕ РАЗНОСТЬДАТ(ВТ_ВосстановленныеДетали.ДатаВосстановления, &amp;ТекДата, ДЕНЬ)
				КОНЕЦ
		ИНАЧЕ ВЫБОР
				КОГДА РАЗНОСТЬДАТ(ВТ_ВосстановленныеДетали.ДатаВосстановления, ВТ_ПроданныеДетали.ДатаПродажи, ДЕНЬ) = 0
					ТОГДА 1
				ИНАЧЕ РАЗНОСТЬДАТ(ВТ_ВосстановленныеДетали.ДатаВосстановления, ВТ_ПроданныеДетали.ДатаПродажи, ДЕНЬ)
			КОНЕЦ
	КОНЕЦ КАК КоличествоДней,
	1 КАК Количество,
	ВТ_ВосстановленныеДетали.НоменклатураРекомендованаяЦена КАК ЦенаДетали,
	ИндНомер.Стеллаж КАК МестоХранения,
	ВЫБОР
		КОГДА ВТ_ПроданныеДетали.Цена ЕСТЬ NULL
			ТОГДА ВЫБОР
					КОГДА ВТ_ЗаказНаряд.Цена ЕСТЬ NULL
						ТОГДА ""
					ИНАЧЕ ВТ_ЗаказНаряд.Цена
				КОНЕЦ
		ИНАЧЕ ВТ_ПроданныеДетали.Цена
	КОНЕЦ КАК ЦенаРеализации,
	ВЫБОР
		КОГДА ВТ_ПроданныеДетали.Заказчик ЕСТЬ NULL
			ТОГДА ВЫБОР
					КОГДА ВТ_ЗаказНаряд.Клиент ЕСТЬ NULL
						ТОГДА ""
					ИНАЧЕ ВТ_ЗаказНаряд.Клиент
				КОНЕЦ
		ИНАЧЕ ВТ_ПроданныеДетали.Заказчик
	КОНЕЦ КАК Заказчик,
	ВТ_ВосстановленныеДетали.Себестоимость КАК Себестоимость
ИЗ
	ВТ_ВосстановленныеДетали КАК ВТ_ВосстановленныеДетали
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПроданныеДетали КАК ВТ_ПроданныеДетали
		ПО (ВТ_ВосстановленныеДетали.ИндКод = ВТ_ПроданныеДетали.Партия)
			И (ВТ_ПроданныеДетали.ДатаПродажи &gt; ВТ_ВосстановленныеДетали.ДатаВосстановления)
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ИндНомер КАК ИндНомер
		ПО (ВТ_ВосстановленныеДетали.ИндКод = ИндНомер.индкод)
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ЗаказНаряд КАК ВТ_ЗаказНаряд
		ПО (ВТ_ВосстановленныеДетали.ИндКод = ВТ_ЗаказНаряд.Партия)

УПОРЯДОЧИТЬ ПО
	ДатаВосстановления УБЫВ</query>
	</dataSet>
	<totalField>
		<dataPath>Количество</dataPath>
		<expression>Сумма(Количество)</expression>
	</totalField>
	<totalField>
		<dataPath>Себестоимость</dataPath>
		<expression>Сумма(Себестоимость)</expression>
	</totalField>
	<totalField>
		<dataPath>ЦенаДетали</dataPath>
		<expression>Сумма(ЦенаДетали)</expression>
	</totalField>
	<totalField>
		<dataPath>ЦенаРеализации</dataPath>
		<expression>Сумма(ЦенаРеализации)</expression>
	</totalField>
	<parameter>
		<name>ТекДата</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Тек дата</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<useRestriction>true</useRestriction>
		<expression>ТекущаяДата()</expression>
		<use>Always</use>
	</parameter>
	<parameter>
		<name>ДатаОкончания</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Дата окончания</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<useRestriction>true</useRestriction>
		<expression>&amp;Период.ДатаОкончания</expression>
	</parameter>
	<parameter>
		<name>ДатаНачала</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Дата начала</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<useRestriction>true</useRestriction>
		<expression>&amp;Период.ДатаНачала</expression>
	</parameter>
	<parameter>
		<name>Период</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Период</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>v8:StandardPeriod</v8:Type>
		</valueType>
		<value xsi:nil="true"/>
		<useRestriction>false</useRestriction>
	</parameter>
	<settingsVariant>
		<dcsset:name>ПродажаВосстановленныхДеталей</dcsset:name>
		<dcsset:presentation xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Продажа восстановленных деталей</v8:content>
			</v8:item>
		</dcsset:presentation>
		<dcsset:settings xmlns:style="http://v8.1c.ru/8.1/data/ui/style" xmlns:sys="http://v8.1c.ru/8.1/data/ui/fonts/system" xmlns:web="http://v8.1c.ru/8.1/data/ui/colors/web" xmlns:win="http://v8.1c.ru/8.1/data/ui/colors/windows">
			<dcsset:selection>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>ИндКод</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>ДатаВосстановления</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>ДатаРеализации</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>Количество</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>КоличествоДней</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>ЦенаДетали</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>МестоХранения</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>ЦенаРеализации</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>Заказчик</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>Себестоимость</dcsset:field>
				</dcsset:item>
			</dcsset:selection>
			<dcsset:dataParameters>
				<dcscor:item xsi:type="dcsset:SettingsParameterValue">
					<dcscor:parameter>Период</dcscor:parameter>
					<dcsset:userSettingID>9ff789e7-7f5d-4eaa-8c34-79e09260a1ac</dcsset:userSettingID>
				</dcscor:item>
			</dcsset:dataParameters>
			<dcsset:order>
				<dcsset:item xsi:type="dcsset:OrderItemField">
					<dcsset:field>ДатаВосстановления</dcsset:field>
					<dcsset:orderType>Asc</dcsset:orderType>
				</dcsset:item>
			</dcsset:order>
			<dcsset:outputParameters>
				<dcscor:item xsi:type="dcsset:SettingsParameterValue">
					<dcscor:parameter>РасположениеПолейГруппировки</dcscor:parameter>
					<dcscor:value xsi:type="dcsset:DataCompositionGroupFieldsPlacement">Separately</dcscor:value>
				</dcscor:item>
			</dcsset:outputParameters>
			<dcsset:item xsi:type="dcsset:StructureItemGroup">
				<dcsset:groupItems>
					<dcsset:item xsi:type="dcsset:GroupItemField">
						<dcsset:field>Номенклатура</dcsset:field>
						<dcsset:groupType>Items</dcsset:groupType>
						<dcsset:periodAdditionType>None</dcsset:periodAdditionType>
					</dcsset:item>
				</dcsset:groupItems>
				<dcsset:order>
					<dcsset:item xsi:type="dcsset:OrderItemAuto"/>
				</dcsset:order>
				<dcsset:selection>
					<dcsset:item xsi:type="dcsset:SelectedItemAuto"/>
				</dcsset:selection>
				<dcsset:item xsi:type="dcsset:StructureItemGroup">
					<dcsset:order>
						<dcsset:item xsi:type="dcsset:OrderItemField">
							<dcsset:field>ДатаВосстановления</dcsset:field>
							<dcsset:orderType>Asc</dcsset:orderType>
						</dcsset:item>
					</dcsset:order>
					<dcsset:selection>
						<dcsset:item xsi:type="dcsset:SelectedItemAuto"/>
					</dcsset:selection>
				</dcsset:item>
			</dcsset:item>
		</dcsset:settings>
	</settingsVariant>
</DataCompositionSchema>