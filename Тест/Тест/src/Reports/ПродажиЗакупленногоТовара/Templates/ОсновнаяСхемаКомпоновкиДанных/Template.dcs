<?xml version="1.0" encoding="UTF-8"?>
<DataCompositionSchema xmlns="http://v8.1c.ru/8.1/data-composition-system/schema" xmlns:dcscom="http://v8.1c.ru/8.1/data-composition-system/common" xmlns:dcscor="http://v8.1c.ru/8.1/data-composition-system/core" xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings" xmlns:v8="http://v8.1c.ru/8.1/data/core" xmlns:v8ui="http://v8.1c.ru/8.1/data/ui" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<dataSource>
		<name>ИсточникДанных1</name>
		<dataSourceType>Local</dataSourceType>
	</dataSource>
	<dataSet xsi:type="DataSetQuery">
		<name>НаборДанных1</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>Партия</dataPath>
			<field>Партия</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Товар</dataPath>
			<field>Товар</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ДатаЗакупки</dataPath>
			<field>ДатаЗакупки</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ДатаПродажи</dataPath>
			<field>ДатаПродажи</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Дата продажи</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>КоличествоДней</dataPath>
			<field>КоличествоДней</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Количество дней</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ПоступлениеЗапчастейТаблица.Партия КАК Партия,
	ПоступлениеЗапчастейТаблица.Товар КАК Товар,
	ПоступлениеЗапчастейТаблица.Ссылка.Дата КАК ДатаЗакупки
ПОМЕСТИТЬ ВТ_ЗакупленныеДетали
ИЗ
	Документ.ПоступлениеЗапчастей.Таблица КАК ПоступлениеЗапчастейТаблица
ГДЕ
	ПоступлениеЗапчастейТаблица.Ссылка.Новые
	И ПоступлениеЗапчастейТаблица.Ссылка.Дата МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания
	И ПоступлениеЗапчастейТаблица.Партия &lt;&gt; ЗНАЧЕНИЕ(Справочник.индКод.ПустаяСсылка)

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ПоступлениеЗапчастейТаблица.Партия,
	ПоступлениеЗапчастейТаблица.Товар,
	ПоступлениеЗапчастейТаблица.Ссылка.Дата
ИЗ
	Документ.ПоступлениеЗапчастей.Таблица КАК ПоступлениеЗапчастейТаблица
ГДЕ
	ПоступлениеЗапчастейТаблица.Ссылка.Перекуп
	И ПоступлениеЗапчастейТаблица.Ссылка.Дата МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания
	И ПоступлениеЗапчастейТаблица.Партия &lt;&gt; ЗНАЧЕНИЕ(Справочник.индКод.ПустаяСсылка)

ИНДЕКСИРОВАТЬ ПО
	Партия
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ПродажаЗапчастейТаблица.Партия КАК Партия,
	ПродажаЗапчастейТаблица.Товар КАК Товар,
	ПродажаЗапчастейТаблица.ДатаВыдачи КАК ДатаПродажи
ПОМЕСТИТЬ Вт_ПроданныеДетали
ИЗ
	Документ.ПродажаЗапчастей.Таблица КАК ПродажаЗапчастейТаблица
ГДЕ
	ПродажаЗапчастейТаблица.Партия В
		(ВЫБРАТЬ
			ВТ_ЗакупленныеДетали.Партия
		ИЗ
			ВТ_ЗакупленныеДетали КАК ВТ_ЗакупленныеДетали)
	И ПродажаЗапчастейТаблица.Ссылка.Проведен

ИНДЕКСИРОВАТЬ ПО
	Партия
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_ЗакупленныеДетали.Партия КАК Партия,
	ВТ_ЗакупленныеДетали.Товар КАК Товар,
	ВТ_ЗакупленныеДетали.ДатаЗакупки КАК ДатаЗакупки,
	ЕСТЬNULL(Вт_ПроданныеДетали.ДатаПродажи, "Нет продажи") КАК ДатаПродажи,
	ВЫБОР
		КОГДА Вт_ПроданныеДетали.ДатаПродажи ЕСТЬ NULL
		ИЛИ Вт_ПроданныеДетали.ДатаПродажи = ДАТАВРЕМЯ(1, 1, 1)
			ТОГДА ВЫБОР
				КОГДА РАЗНОСТЬДАТ(ВТ_ЗакупленныеДетали.ДатаЗакупки, &amp;ТекДата, ДЕНЬ) = 0
					ТОГДА 1
				ИНАЧЕ РАЗНОСТЬДАТ(ВТ_ЗакупленныеДетали.ДатаЗакупки, &amp;ТекДата, ДЕНЬ)
			КОНЕЦ
		ИНАЧЕ ВЫБОР
			КОГДА РАЗНОСТЬДАТ(ВТ_ЗакупленныеДетали.ДатаЗакупки, Вт_ПроданныеДетали.ДатаПродажи, ДЕНЬ) = 0
				ТОГДА 1
			ИНАЧЕ РАЗНОСТЬДАТ(ВТ_ЗакупленныеДетали.ДатаЗакупки, Вт_ПроданныеДетали.ДатаПродажи, ДЕНЬ)
		КОНЕЦ
	КОНЕЦ КАК КоличествоДней
ИЗ
	ВТ_ЗакупленныеДетали КАК ВТ_ЗакупленныеДетали
		ЛЕВОЕ СОЕДИНЕНИЕ Вт_ПроданныеДетали КАК Вт_ПроданныеДетали
		ПО ВТ_ЗакупленныеДетали.Партия = Вт_ПроданныеДетали.Партия</query>
	</dataSet>
	<parameter>
		<name>ДатаОкончания</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Дата окончания</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<useRestriction>true</useRestriction>
		<expression>&amp;Период.ДатаОкончания</expression>
	</parameter>
	<parameter>
		<name>ДатаНачала</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Дата начала</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<useRestriction>true</useRestriction>
		<expression>&amp;Период.ДатаНачала</expression>
	</parameter>
	<parameter>
		<name>ТекДата</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Тек дата</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<useRestriction>true</useRestriction>
		<expression>ТекущаяДата()</expression>
		<use>Always</use>
	</parameter>
	<parameter>
		<name>Период</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Период</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>v8:StandardPeriod</v8:Type>
		</valueType>
		<value xsi:nil="true"/>
		<useRestriction>false</useRestriction>
	</parameter>
	<settingsVariant>
		<dcsset:name>Основной</dcsset:name>
		<dcsset:presentation xsi:type="xs:string">Основной</dcsset:presentation>
		<dcsset:settings xmlns:style="http://v8.1c.ru/8.1/data/ui/style" xmlns:sys="http://v8.1c.ru/8.1/data/ui/fonts/system" xmlns:web="http://v8.1c.ru/8.1/data/ui/colors/web" xmlns:win="http://v8.1c.ru/8.1/data/ui/colors/windows">
			<dcsset:selection>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>Товар</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>Партия</dcsset:field>
					<dcsset:lwsTitle>
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>Деталь</v8:content>
						</v8:item>
					</dcsset:lwsTitle>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>ДатаЗакупки</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>ДатаПродажи</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>КоличествоДней</dcsset:field>
				</dcsset:item>
			</dcsset:selection>
			<dcsset:dataParameters>
				<dcscor:item xsi:type="dcsset:SettingsParameterValue">
					<dcscor:parameter>Период</dcscor:parameter>
					<dcsset:userSettingID>05ec6e28-c805-4438-b2fe-d8c08aaecd1a</dcsset:userSettingID>
				</dcscor:item>
			</dcsset:dataParameters>
			<dcsset:outputParameters>
				<dcscor:item xsi:type="dcsset:SettingsParameterValue">
					<dcscor:parameter>РасположениеПолейГруппировки</dcscor:parameter>
					<dcscor:value xsi:type="dcsset:DataCompositionGroupFieldsPlacement">Separately</dcscor:value>
				</dcscor:item>
			</dcsset:outputParameters>
			<dcsset:item xsi:type="dcsset:StructureItemGroup">
				<dcsset:groupItems>
					<dcsset:item xsi:type="dcsset:GroupItemField">
						<dcsset:field>Товар</dcsset:field>
						<dcsset:groupType>Items</dcsset:groupType>
						<dcsset:periodAdditionType>None</dcsset:periodAdditionType>
					</dcsset:item>
				</dcsset:groupItems>
				<dcsset:order>
					<dcsset:item xsi:type="dcsset:OrderItemAuto"/>
				</dcsset:order>
				<dcsset:selection>
					<dcsset:item xsi:type="dcsset:SelectedItemAuto"/>
				</dcsset:selection>
				<dcsset:item xsi:type="dcsset:StructureItemGroup">
					<dcsset:order>
						<dcsset:item xsi:type="dcsset:OrderItemAuto"/>
					</dcsset:order>
					<dcsset:selection>
						<dcsset:item xsi:type="dcsset:SelectedItemAuto"/>
					</dcsset:selection>
				</dcsset:item>
			</dcsset:item>
		</dcsset:settings>
	</settingsVariant>
</DataCompositionSchema>