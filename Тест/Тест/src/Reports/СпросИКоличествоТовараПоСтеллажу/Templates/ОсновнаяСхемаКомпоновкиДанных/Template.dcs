<?xml version="1.0" encoding="UTF-8"?>
<DataCompositionSchema xmlns="http://v8.1c.ru/8.1/data-composition-system/schema" xmlns:dcscom="http://v8.1c.ru/8.1/data-composition-system/common" xmlns:dcscor="http://v8.1c.ru/8.1/data-composition-system/core" xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings" xmlns:v8="http://v8.1c.ru/8.1/data/core" xmlns:v8ui="http://v8.1c.ru/8.1/data/ui" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<dataSource>
		<name>ИсточникДанных1</name>
		<dataSourceType>Local</dataSourceType>
	</dataSource>
	<dataSet xsi:type="DataSetQuery">
		<name>НаборДанных1</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>Склад</dataPath>
			<field>Склад</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Товар</dataPath>
			<field>Товар</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>индкод</dataPath>
			<field>индкод</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>машина</dataPath>
			<field>машина</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Номенклатура</dataPath>
			<field>Номенклатура</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Цена</dataPath>
			<field>Цена</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Код</dataPath>
			<field>Код</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Код</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Сумма</dataPath>
			<field>Сумма</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Сумма</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ДатаПервогоПоступления</dataPath>
			<field>ДатаПервогоПоступления</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Дата первого поступления</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>КоличествоПродаж</dataPath>
			<field>КоличествоПродаж</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Количество продаж</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Стеллаж</dataPath>
			<field>Стеллаж</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>КоличествоЗапросов</dataPath>
			<field>КоличествоЗапросов</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Количество запросов</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Организация</dataPath>
			<field>Организация</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Автомобиль</dataPath>
			<field>Автомобиль</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Менеджер</dataPath>
			<field>Менеджер</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Подразделение</dataPath>
			<field>Подразделение</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>КоличествоНаПолке</dataPath>
			<field>КоличествоНаПолке</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Количество на полке</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ОстатокВсего</dataPath>
			<field>ОстатокВсего</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>СуммаВсего</dataPath>
			<field>СуммаВсего</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Сумма всего</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ОстатокПоСкладу</dataPath>
			<field>ОстатокПоСкладу</field>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ИндНомер.индкод.Владелец КАК Номенклатура,
	МАКСИМУМ(ИндНомер.индкод.Владелец.Код) КАК Код,
	КОЛИЧЕСТВО(ИндНомер.индкод) КАК Количество,
	МАКСИМУМ(ИндНомер.Цена) КАК Цена,
	СУММА(ИндНомер.Цена) КАК Сумма,
	МАКСИМУМ(ИндНомер.Стеллаж) КАК Стеллаж,
	Минимум(РегистрНакопления1Остатки.Склад) КАК Склад
ПОМЕСТИТЬ ВТ_ТоварыСтеллаж
ИЗ
	РегистрСведений.ИндНомер КАК ИндНомер
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.РегистрНакопления1.Остатки КАК РегистрНакопления1Остатки
		ПО (ИндНомер.индкод = РегистрНакопления1Остатки.индкод)
ГДЕ
	ИндНомер.Стеллаж = &amp;Стеллаж
	И РегистрНакопления1Остатки.КолвоОстаток &gt; 0

СГРУППИРОВАТЬ ПО
	ИндНомер.индкод.Владелец
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ПоступлениеЗапчастейТаблица.Товар КАК Товар,
	МИНИМУМ(ПоступлениеЗапчастейТаблица.Ссылка.Дата) КАК Дата
ПОМЕСТИТЬ ВТ_ДатаПервогоПоступления
ИЗ
	Документ.ПоступлениеЗапчастей.Таблица КАК ПоступлениеЗапчастейТаблица
ГДЕ
	ПоступлениеЗапчастейТаблица.Товар В
			(ВЫБРАТЬ
				ВТ_ТоварыСтеллаж.Номенклатура
			ИЗ
				ВТ_ТоварыСтеллаж КАК ВТ_ТоварыСтеллаж)

СГРУППИРОВАТЬ ПО
	ПоступлениеЗапчастейТаблица.Товар
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ЗаказКлиентаТовары.Номенклатура КАК Номенклатура,
	КОЛИЧЕСТВО(ЗаказКлиентаТовары.Ссылка) КАК Количество
ПОМЕСТИТЬ ВТ_СпросЗаявки
ИЗ
	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
ГДЕ
	ЗаказКлиентаТовары.Номенклатура В
			(ВЫБРАТЬ
				ВТ_ТоварыСтеллаж.Номенклатура
			ИЗ
				ВТ_ТоварыСтеллаж КАК ВТ_ТоварыСтеллаж)
	И ЗаказКлиентаТовары.Ссылка.Дата МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания

СГРУППИРОВАТЬ ПО
	ЗаказКлиентаТовары.Номенклатура
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	РегистрНакопления1Остатки.Товар КАК Товар,
	СУММА(РегистрНакопления1Остатки.КолвоОстаток) КАК ОстатокВсего
ПОМЕСТИТЬ ВТ_ВсеОстатки
ИЗ
	РегистрНакопления.РегистрНакопления1.Остатки(
			,
			Товар В
				(ВЫБРАТЬ
					ВТ_ТоварыСтеллаж.Номенклатура
				ИЗ
					ВТ_ТоварыСтеллаж КАК ВТ_ТоварыСтеллаж)) КАК РегистрНакопления1Остатки

СГРУППИРОВАТЬ ПО
	РегистрНакопления1Остатки.Товар
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	РегистрНакопления1Остатки.Товар КАК Товар,
	СУММА(РегистрНакопления1Остатки.КолвоОстаток) КАК ОстатокПоСкладу,
	РегистрНакопления1Остатки.Склад КАК Склад
ПОМЕСТИТЬ ВТ_ОстаткиПоСкладу
ИЗ
	РегистрНакопления.РегистрНакопления1.Остатки(
			,
			Товар В
				(ВЫБРАТЬ
					ВТ_ТоварыСтеллаж.Номенклатура
				ИЗ
					ВТ_ТоварыСтеллаж КАК ВТ_ТоварыСтеллаж)) КАК РегистрНакопления1Остатки

СГРУППИРОВАТЬ ПО
	РегистрНакопления1Остатки.Склад,
	РегистрНакопления1Остатки.Товар
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_ТоварыСтеллаж.Номенклатура КАК Номенклатура,
	ВТ_ТоварыСтеллаж.Код КАК Код,
	ВТ_ТоварыСтеллаж.Количество КАК КоличествоНаПолке,
	ВТ_ТоварыСтеллаж.Цена КАК Цена,
	ВТ_ТоварыСтеллаж.Сумма КАК Сумма,
	ВТ_ДатаПервогоПоступления.Дата КАК ДатаПервогоПоступления,
	ПродажиОбороты.КоличествоОборот КАК КоличествоПродаж,
	ВТ_ТоварыСтеллаж.Стеллаж КАК Стеллаж,
	ВТ_СпросЗаявки.Количество КАК КоличествоЗапросов,
	ВТ_ВсеОстатки.ОстатокВсего КАК ОстатокВсего,
	ВТ_ТоварыСтеллаж.Цена * ВТ_ВсеОстатки.ОстатокВсего КАК СуммаВсего,
	ВТ_ТоварыСтеллаж.Склад КАК Склад,
	ВТ_ОстаткиПоСкладу.ОстатокПоСкладу КАК ОстатокПоСкладу
ИЗ
	ВТ_ТоварыСтеллаж КАК ВТ_ТоварыСтеллаж
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.Продажи.Обороты(&amp;ДатаНачала, &amp;ДатаОкончания, , ) КАК ПродажиОбороты
		ПО (ВТ_ТоварыСтеллаж.Номенклатура = ПродажиОбороты.Номенклатура)
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ДатаПервогоПоступления КАК ВТ_ДатаПервогоПоступления
		ПО (ВТ_ДатаПервогоПоступления.Товар = ВТ_ТоварыСтеллаж.Номенклатура)
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_СпросЗаявки КАК ВТ_СпросЗаявки
		ПО (ВТ_ТоварыСтеллаж.Номенклатура = ВТ_СпросЗаявки.Номенклатура)
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ВсеОстатки КАК ВТ_ВсеОстатки
		ПО (ВТ_ТоварыСтеллаж.Номенклатура = ВТ_ВсеОстатки.Товар)
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ОстаткиПоСкладу КАК ВТ_ОстаткиПоСкладу
		ПО (ВТ_ТоварыСтеллаж.Номенклатура = ВТ_ОстаткиПоСкладу.Товар)
			И (ВТ_ОстаткиПоСкладу.Склад = ВТ_ТоварыСтеллаж.Склад)</query>
	</dataSet>
	<totalField>
		<dataPath>КоличествоЗапросов</dataPath>
		<expression>Сумма(КоличествоЗапросов)</expression>
	</totalField>
	<totalField>
		<dataPath>КоличествоНаПолке</dataPath>
		<expression>Сумма(КоличествоНаПолке)</expression>
	</totalField>
	<totalField>
		<dataPath>КоличествоПродаж</dataPath>
		<expression>Сумма(КоличествоПродаж)</expression>
	</totalField>
	<totalField>
		<dataPath>ОстатокВсего</dataPath>
		<expression>Сумма(ОстатокВсего)</expression>
	</totalField>
	<totalField>
		<dataPath>ОстатокПоСкладу</dataPath>
		<expression>Сумма(ОстатокПоСкладу)</expression>
	</totalField>
	<totalField>
		<dataPath>Сумма</dataPath>
		<expression>Сумма(Сумма)</expression>
	</totalField>
	<totalField>
		<dataPath>СуммаВсего</dataPath>
		<expression>Сумма(СуммаВсего)</expression>
	</totalField>
	<totalField>
		<dataPath>Цена</dataPath>
		<expression>Максимум(Цена)</expression>
	</totalField>
	<parameter>
		<name>НачалоПериода</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Начало периода</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>false</useRestriction>
	</parameter>
	<parameter>
		<name>КонецПериода</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Конец периода</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>false</useRestriction>
	</parameter>
	<parameter>
		<name>Период</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Период</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>false</useRestriction>
	</parameter>
	<parameter>
		<name>ДатаНачала</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Дата начала</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>true</useRestriction>
		<expression>&amp;ПериодОтчета.ДатаНачала</expression>
	</parameter>
	<parameter>
		<name>ДатаОкончания</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Дата окончания</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>true</useRestriction>
		<expression>&amp;ПериодОтчета.ДатаОкончания</expression>
	</parameter>
	<parameter>
		<name>Стеллаж</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Стеллаж</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type xmlns:d4p1="http://v8.1c.ru/8.1/data/enterprise/current-config">d4p1:CatalogRef.Стеллаж</v8:Type>
		</valueType>
		<value xsi:nil="true"/>
		<useRestriction>false</useRestriction>
	</parameter>
	<parameter>
		<name>ПериодОтчета</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Период отчета</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>v8:StandardPeriod</v8:Type>
		</valueType>
		<value xsi:type="v8:StandardPeriod">
			<v8:variant xsi:type="v8:StandardPeriodVariant">Custom</v8:variant>
			<v8:startDate>0001-01-01T00:00:00</v8:startDate>
			<v8:endDate>0001-01-01T00:00:00</v8:endDate>
		</value>
		<useRestriction>false</useRestriction>
	</parameter>
	<settingsVariant>
		<dcsset:name>Основной</dcsset:name>
		<dcsset:presentation xsi:type="xs:string">Основной</dcsset:presentation>
		<dcsset:settings xmlns:style="http://v8.1c.ru/8.1/data/ui/style" xmlns:sys="http://v8.1c.ru/8.1/data/ui/fonts/system" xmlns:web="http://v8.1c.ru/8.1/data/ui/colors/web" xmlns:win="http://v8.1c.ru/8.1/data/ui/colors/windows">
			<dcsset:selection>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>Номенклатура</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>Код</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>КоличествоНаПолке</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>Цена</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>Сумма</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>КоличествоПродаж</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>ДатаПервогоПоступления</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>КоличествоЗапросов</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>Стеллаж</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>Склад</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>ОстатокПоСкладу</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>ОстатокВсего</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>СуммаВсего</dcsset:field>
				</dcsset:item>
			</dcsset:selection>
