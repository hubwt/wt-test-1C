Функция Забронироватьreserve(Запрос)
	
	АйдиТовара = Новый Массив();
	//====================================================================================================================
	Тело = Запрос.ПолучитьТелоКакстроку();
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(Тело);
	СтруктураТела = ПрочитатьJSON(ЧтениеJSON);
	
	АйдиТовара 		= СтруктураТела.tovId; 
	НомерТелефона	= СтруктураТела.phone; 
	//===================================================================================================================
	
	Если  АйдиТовара.Количество() < 1 ИЛИ НЕ ЗначениеЗаполнено(НомерТелефона) Тогда 
		
		СтуктураОшибки = Новый Структура;
		СтуктураОшибки.Вставить("error","8670");
		Ответ = Новый HTTPСервисОтвет(400); 
		Ответ.Заголовки.Вставить("Content-type", "application/json;  charset=utf-8");
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, СтуктураОшибки);
		СтрокаДляОтвета = ЗаписьJSON.Закрыть();
		Ответ.УстановитьТелоИзСтроки(СтрокаДляОтвета);
		Возврат Ответ;
			
	КонецЕсли; 
	
	Ответ = ОперативныйУчетАкция10.ЗабронироватьТовар(АйдиТовара,НомерТелефона); 
	Возврат Ответ;

КонецФункции

Функция ДобавитьВАкциюТоварМетод(Запрос)
	//=======================================================================================================================
	Тело = Запрос.ПолучитьТелоКакСтроку();
	ЧтениеJSON = Новый ЧтениеJSON();
	ЧтениеJSON.УстановитьСтроку(Тело);
	СтруктураТела = ПрочитатьJSON(ЧтениеJSON);
	АйдиТовара = СтруктураТела.tovId;  
	//===================================================================================================================
	Если  НЕ ЗначениеЗаполнено(АйдиТовара) Тогда 
		СтуктураОшибки = Новый Структура;
		СтуктураОшибки.Вставить("error","2335");
		Ответ = Новый HTTPСервисОтвет(400); 
		Ответ.Заголовки.Вставить("Content-type", "application/json;  charset=utf-8");
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, СтуктураОшибки);
		СтрокаДляОтвета = ЗаписьJSON.Закрыть();
		Ответ.УстановитьТелоИзСтроки(СтрокаДляОтвета);
		Возврат Ответ;
	КонецЕсли;
	//===================================================================================================================
	
	Ответ = ОперативныйУчетАкция10.ДобавитьВАкциюТовар(АйдиТовара);
	Возврат Ответ;
КонецФункции
