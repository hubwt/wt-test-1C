Функция СформироватьСтруктуруОшибки(Message, Details)

	СтруктураОтвета = Новый Структура;

	СтруктураОтвета.Вставить("message", Message);
	СтруктураОтвета.Вставить("details", Details);

	Возврат СтруктураОтвета;
КонецФункции

Функция Авторизацияauth(Запрос)
//==================================================================================================================	
	Тело = Запрос.ПолучитьТелоКакстроку();
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(Тело);
	СтруктураТела = ПрочитатьJSON(ЧтениеJSON);
	
	НомерТелефона				= СтруктураТела.phone; 
	Имя							= СтруктураТела.name;
	 
//==================================================================================================================
	Если НЕ ЗначениеЗаполнено (НомерТелефона) ИЛи НЕ ЗначениеЗаполнено(Имя) Тогда 
		СтуктураОшибки = Новый Структура;
		СтуктураОшибки.Вставить("error","8670");
		Ответ = Новый HTTPСервисОтвет(400); 
		Ответ.Заголовки.Вставить("Content-type", "application/json;  charset=utf-8");
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, СтуктураОшибки);
		СтрокаДляОтвета = ЗаписьJSON.Закрыть();
		Ответ.УстановитьТелоИзСтроки(СтрокаДляОтвета);
		Возврат Ответ;	
	КонецЕсли; 
//==================================================================================================================	
	
	Ответ = ОперативныйУчетАкция10. СоздатьНовогоучастникаАкции(Имя,НомерТелефона); 
	Возврат Ответ;

КонецФункции

Функция СписокТоваровlistOfProducts(Запрос)
	//\ 765
	Массив = ОперативныйУчетАкция10.СписокТоваровАкция10(); 
	Если ЗначениеЗаполнено(Массив) Тогда 
		
		Ответ = Новый HTTPСервисОтвет(200);
		Ответ.Заголовки.Вставить("Content-type", "application/json;  charset=utf-8");
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		Информация = ИнформацияОбОшибке();
		ЗаписатьJSON(ЗаписьJSON, Массив);
		СтрокаДляОтвета = ЗаписьJSON.Закрыть();
		Ответ.УстановитьТелоИзСтроки(СтрокаДляОтвета);
		Возврат Ответ;

	Иначе
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, СформироватьСтруктуруОшибки("Товар не найден",
			"Ошибка при вызове чего - там"));
		СтрокаДляОтвета = ЗаписьJSON.Закрыть();
		Ответ = Новый HTTPСервисОтвет(500);
		Ответ.Заголовки.Вставить("Content-type", "application/json;  charset=utf-8");
		Ответ.УстановитьТелоИзСтроки( СтрокаДляОтвета);
	КонецЕсли;

КонецФункции

