  <enabled>true</enabled>
  <showTitle>true</showTitle>
  <showCloseButton>true</showCloseButton>
  <attributes>
    <name>Объект</name>
    <id>1</id>
    <valueType>
      <types>DataProcessorObject.РабочееМестоРОП</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <main>true</main>
  </attributes>
  <attributes>
    <name>АналитикаПоМенеджерам</name>
    <title>
      <key>ru</key>
      <value>Аналитика по менеджерам</value>
    </title>
    <id>2</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	ЗаказКлиента.Ответственный КАК Менеджер,
	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЗаказКлиента.Ссылка) КАК КоличествоЗаявокВсего,
	СУММА(ЗаказКлиента.СуммаДокумента) КАК СуммаЗаявок
ПОМЕСТИТЬ ВТ_КоличествоСуммаЗаявокПоМенеджеруВсего
ИЗ
	Документ.ЗаказКлиента КАК ЗаказКлиента
ГДЕ
	ЗаказКлиента.Дата МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания

СГРУППИРОВАТЬ ПО
	ЗаказКлиента.Ответственный
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ЗаказКлиента.Ответственный КАК Менеджер,
	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЗаказКлиента.Ссылка) КАК КоличествоЗаявокСсайта
ПОМЕСТИТЬ ВТ_КоличествоЗаявокССайтаПоМенеджеруВсего
ИЗ
	Документ.ЗаказКлиента КАК ЗаказКлиента
ГДЕ
	(ЗаказКлиента.ЗаявкаСозданаССайтаКлиента
			ИЛИ ЗаказКлиента.ЗаявкаССайта)
	И ЗаказКлиента.Дата МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания

СГРУППИРОВАТЬ ПО
	ЗаказКлиента.Ответственный
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ПредварительныйСчет.КтоПродал КАК Менеджер,
	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ПредварительныйСчет.Ссылка) КАК КоличествоВыставленныхСчетовНеОплаченных,
	СУММА(ПредварительныйСчет.ИтогоРекв) КАК СуммаВыставленныхСчетовНеОплаченных
ПОМЕСТИТЬ ВТ_ВыставленныеСчетаНеОплаченные
ИЗ
	Документ.ПредварительныйСчет КАК ПредварительныйСчет
ГДЕ
	НЕ ПредварительныйСчет.Оплачено
	И ВЫРАЗИТЬ(ПредварительныйСчет.Основание КАК Документ.ЗаказКлиента).Дата МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания

СГРУППИРОВАТЬ ПО
	ПредварительныйСчет.КтоПродал
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ПродажаЗапчастей.КтоПродал КАК Менеджер,
	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ПродажаЗапчастей.Ссылка) КАК КоличествоПродажПоЗаявкам,
	СУММА(ПродажаЗапчастей.ИтогоРекв) КАК СуммаПродажПоЗаявкам,
	СУММА(ДокЗаказКлиента.СуммаДокумента) КАК СуммаЗаявокПерешедшихВПродажу
ПОМЕСТИТЬ ВТ_КоличествоСуммаПродажИзЗаявок
ИЗ
	Документ.ЗаказКлиента КАК ДокЗаказКлиента
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПродажаЗапчастей КАК ПродажаЗапчастей
		ПО ДокЗаказКлиента.Ссылка = ПродажаЗапчастей.ЗаказКлиента
			И (ДокЗаказКлиента.Дата МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания)
			И (ДокЗаказКлиента.ЭтапыПродажи = ЗНАЧЕНИЕ(Перечисление.Этапыпродажи.Отправлено)
				ИЛИ ДокЗаказКлиента.ЭтапыПродажи = ЗНАЧЕНИЕ(Перечисление.Этапыпродажи.собрано))

СГРУППИРОВАТЬ ПО
	ПродажаЗапчастей.КтоПродал
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ЗаказКлиента.Ответственный КАК Менеджер,
	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЗаказКлиента.Ссылка) КАК КоличествоЗаявокДо50тр
ПОМЕСТИТЬ ВТ_КоличествоЗаявокДо50тр
ИЗ
	Документ.ЗаказКлиента КАК ЗаказКлиента
ГДЕ
	ЗаказКлиента.Дата МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания
	И ЗаказКлиента.СуммаДокумента &lt; 50000

СГРУППИРОВАТЬ ПО
	ЗаказКлиента.Ответственный
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ЗаказКлиента.Ответственный КАК Менеджер,
	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЗаказКлиента.Ссылка) КАК КоличествоЗаявокОт50трДо500тр
ПОМЕСТИТЬ ВТ_КоличествоЗаявокОт50трДо500тр
ИЗ
	Документ.ЗаказКлиента КАК ЗаказКлиента
ГДЕ
	ЗаказКлиента.Дата МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания
	И ЗаказКлиента.СуммаДокумента >= 50000
	И ЗаказКлиента.СуммаДокумента &lt; 500000

СГРУППИРОВАТЬ ПО
	ЗаказКлиента.Ответственный
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ЗаказКлиента.Ответственный КАК Менеджер,
	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЗаказКлиента.Ссылка) КАК КоличествоЗаявокОт500тр
ПОМЕСТИТЬ ВТ_КоличествоЗаявокОт500тр
ИЗ
	Документ.ЗаказКлиента КАК ЗаказКлиента
ГДЕ
	ЗаказКлиента.Дата МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания
	И ЗаказКлиента.СуммаДокумента >= 500000

СГРУППИРОВАТЬ ПО
	ЗаказКлиента.Ответственный
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ЗаказКлиента.Ответственный КАК Менеджер,
	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЗаказКлиента.Ссылка) КАК КоличествоЗаявокВРаботе,
	СУММА(ЗаказКлиента.СуммаДокумента) КАК СуммаЗаявокВРаботе
ПОМЕСТИТЬ ВТ_КоличествоСуммаЗаявокПоМенеджеруВРаботе
ИЗ
	Документ.ЗаказКлиента КАК ЗаказКлиента
ГДЕ
	ЗаказКлиента.Дата МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания
	И ЗаказКлиента.ЭтапыПродажи = ЗНАЧЕНИЕ(Перечисление.ЭтапыПродажи.ВРаботе)

СГРУППИРОВАТЬ ПО
	ЗаказКлиента.Ответственный
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ЗаказКлиента.Ответственный КАК Менеджер,
	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЗаказКлиента.Ссылка) КАК КоличествоЗаявокСобрано,
	СУММА(ЗаказКлиента.СуммаДокумента) КАК СуммаЗаявокСобрано
ПОМЕСТИТЬ ВТ_КоличествоСуммаЗаявокПоМенеджеруСобрано
ИЗ
	Документ.ЗаказКлиента КАК ЗаказКлиента
ГДЕ
	ЗаказКлиента.Дата МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания
	И ЗаказКлиента.ЭтапыПродажи = ЗНАЧЕНИЕ(Перечисление.ЭтапыПродажи.Собрано)

СГРУППИРОВАТЬ ПО
	ЗаказКлиента.Ответственный
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ЗаказКлиента.Ответственный КАК Менеджер,
	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЗаказКлиента.Ссылка) КАК КоличествоЗаявокОтказ,
	СУММА(ЗаказКлиента.СуммаДокумента) КАК СуммаЗаявокОтказ
ПОМЕСТИТЬ ВТ_КоличествоСуммаЗаявокПоМенеджеруОтказ
ИЗ
	Документ.ЗаказКлиента КАК ЗаказКлиента
ГДЕ
	ЗаказКлиента.Дата МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания
	И ЗаказКлиента.ЭтапыПродажи = ЗНАЧЕНИЕ(Перечисление.ЭтапыПродажи.Отказ)

СГРУППИРОВАТЬ ПО
	ЗаказКлиента.Ответственный
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ЗаказКлиента.Ответственный КАК Менеджер,
	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЗаказКлиента.Ссылка) КАК КоличествоЗаявокВРаботеБолее2д
ПОМЕСТИТЬ ВТ_КоличествоЗаявокПоМенеджеруВРаботеБолее2д
ИЗ
	Документ.ЗаказКлиента КАК ЗаказКлиента
ГДЕ
	ЗаказКлиента.Дата МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания
	И ЗаказКлиента.ЭтапыПродажи = ЗНАЧЕНИЕ(Перечисление.ЭтапыПродажи.ВРаботе)
	И РАЗНОСТЬДАТ(ЗаказКлиента.Дата, &amp;ТекущаяДата, ДЕНЬ) > 2

СГРУППИРОВАТЬ ПО
	ЗаказКлиента.Ответственный
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ЗаказКлиента.Ответственный КАК Менеджер,
	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЗаказКлиента.Ссылка) КАК КоличествоЗаявокСобраноБолее3д
ПОМЕСТИТЬ ВТ_КоличествоЗаявокПоМенеджеруСобраноБолее3д
ИЗ
	Документ.ЗаказКлиента КАК ЗаказКлиента
ГДЕ
	ЗаказКлиента.Дата МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания
	И ЗаказКлиента.ЭтапыПродажи = ЗНАЧЕНИЕ(Перечисление.ЭтапыПродажи.Собрано)
	И РАЗНОСТЬДАТ(ЗаказКлиента.Дата, &amp;ТекущаяДата, ДЕНЬ) > 3

СГРУППИРОВАТЬ ПО
	ЗаказКлиента.Ответственный
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ПриходДенегНаСчет.Менеджер КАК Менеджер,
	СУММА(ПриходДенегНаСчет.СуммаДокумента - ЕСТЬNULL(АктВозврата.ОбщаяСумма, 0)) КАК СуммаПоступленийСУчетомВозвратов
ПОМЕСТИТЬ ВТ_ПоступленияДенегСУчетомВозвратов
ИЗ
	Документ.ПриходДенегНаСчет КАК ПриходДенегНаСчет
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.АктВозврата КАК АктВозврата
		ПО (АктВозврата.Продажа = ПриходДенегНаСчет.Сделка)
ГДЕ
	ПриходДенегНаСчет.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПоступлениеДенежныхСредств.Оплатапокупателя)
	И ПриходДенегНаСчет.Дата МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания

СГРУППИРОВАТЬ ПО
	ПриходДенегНаСчет.Менеджер
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ДополнительныеНомера.Менеджер КАК Менеджер,
	ВТ_КоличествоСуммаЗаявокПоМенеджеруВсего.КоличествоЗаявокВсего КАК КоличествоЗаявокВсего,
	ВТ_КоличествоСуммаЗаявокПоМенеджеруВсего.СуммаЗаявок КАК СуммаЗаявок,
	ВТ_КоличествоЗаявокССайтаПоМенеджеруВсего.КоличествоЗаявокСсайта КАК КоличествоЗаявокСсайта,
	ВТ_ВыставленныеСчетаНеОплаченные.КоличествоВыставленныхСчетовНеОплаченных КАК КоличествоВыставленныхСчетовНеОплаченных,
	ВТ_ВыставленныеСчетаНеОплаченные.СуммаВыставленныхСчетовНеОплаченных КАК СуммаВыставленныхСчетовНеОплаченных,
	ВТ_КоличествоСуммаПродажИзЗаявок.КоличествоПродажПоЗаявкам КАК КоличествоПродажПоЗаявкам,
	ВТ_КоличествоСуммаПродажИзЗаявок.СуммаПродажПоЗаявкам КАК СуммаПродажПоЗаявкам,
	ВТ_КоличествоСуммаПродажИзЗаявок.СуммаЗаявокПерешедшихВПродажу КАК СуммаЗаявокПерешедшихВПродажу,
	ВЫБОР
		КОГДА ВТ_КоличествоСуммаЗаявокПоМенеджеруВсего.КоличествоЗаявокВсего &lt;> 0
			ТОГДА ВЫРАЗИТЬ(ВТ_КоличествоСуммаПродажИзЗаявок.КоличествоПродажПоЗаявкам / ВТ_КоличествоСуммаЗаявокПоМенеджеруВсего.КоличествоЗаявокВсего * 100 КАК ЧИСЛО(15, 2))
		ИНАЧЕ 0
	КОНЕЦ КАК Конверсия,
	ВЫБОР
		КОГДА ВТ_КоличествоСуммаПродажИзЗаявок.КоличествоПродажПоЗаявкам &lt;> 0
			ТОГДА ВЫРАЗИТЬ(ВТ_КоличествоСуммаПродажИзЗаявок.СуммаПродажПоЗаявкам / ВТ_КоличествоСуммаПродажИзЗаявок.КоличествоПродажПоЗаявкам КАК ЧИСЛО(15, 2))
		ИНАЧЕ 0
	КОНЕЦ КАК СреднийЧек,
	ВТ_КоличествоЗаявокДо50тр.КоличествоЗаявокДо50тр КАК КоличествоЗаявокДо50тр,
	ВТ_КоличествоЗаявокОт50трДо500тр.КоличествоЗаявокОт50трДо500тр КАК КоличествоЗаявокОт50трДо500тр,
	ВТ_КоличествоЗаявокОт500тр.КоличествоЗаявокОт500тр КАК КоличествоЗаявокОт500тр,
	ВТ_КоличествоСуммаЗаявокПоМенеджеруВРаботе.КоличествоЗаявокВРаботе КАК КоличествоЗаявокВРаботе,
	ВТ_КоличествоСуммаЗаявокПоМенеджеруВРаботе.СуммаЗаявокВРаботе КАК СуммаЗаявокВРаботе,
	ВТ_КоличествоСуммаЗаявокПоМенеджеруСобрано.КоличествоЗаявокСобрано КАК КоличествоЗаявокСобрано,
	ВТ_КоличествоСуммаЗаявокПоМенеджеруСобрано.СуммаЗаявокСобрано КАК СуммаЗаявокСобрано,
	ВТ_КоличествоСуммаЗаявокПоМенеджеруОтказ.КоличествоЗаявокОтказ КАК КоличествоЗаявокОтказ,
	ВТ_КоличествоСуммаЗаявокПоМенеджеруОтказ.СуммаЗаявокОтказ КАК СуммаЗаявокОтказ,
	ВТ_КоличествоЗаявокПоМенеджеруВРаботеБолее2д.КоличествоЗаявокВРаботеБолее2д КАК КоличествоЗаявокВРаботеБолее2д,
	ВТ_КоличествоЗаявокПоМенеджеруСобраноБолее3д.КоличествоЗаявокСобраноБолее3д КАК КоличествоЗаявокСобраноБолее3д,
	ДополнительныеНомера.ИндивидуальныйПланНаМесяц КАК ИндивидуальныйПланНаМесяц,
	ВТ_ПоступленияДенегСУчетомВозвратов.СуммаПоступленийСУчетомВозвратов КАК СуммаПоступленийСУчетомВозвратов
ИЗ
	РегистрСведений.ДополнительныеНомера КАК ДополнительныеНомера
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_КоличествоСуммаЗаявокПоМенеджеруВсего КАК ВТ_КоличествоСуммаЗаявокПоМенеджеруВсего
		ПО (ДополнительныеНомера.Менеджер = ВТ_КоличествоСуммаЗаявокПоМенеджеруВсего.Менеджер)
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_КоличествоЗаявокССайтаПоМенеджеруВсего КАК ВТ_КоличествоЗаявокССайтаПоМенеджеруВсего
		ПО (ДополнительныеНомера.Менеджер = ВТ_КоличествоЗаявокССайтаПоМенеджеруВсего.КоличествоЗаявокСсайта)
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ВыставленныеСчетаНеОплаченные КАК ВТ_ВыставленныеСчетаНеОплаченные
		ПО (ДополнительныеНомера.Менеджер = ВТ_ВыставленныеСчетаНеОплаченные.Менеджер)
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_КоличествоСуммаПродажИзЗаявок КАК ВТ_КоличествоСуммаПродажИзЗаявок
		ПО (ДополнительныеНомера.Менеджер = ВТ_КоличествоСуммаПродажИзЗаявок.Менеджер)
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_КоличествоЗаявокДо50тр КАК ВТ_КоличествоЗаявокДо50тр
		ПО (ДополнительныеНомера.Менеджер = ВТ_КоличествоЗаявокДо50тр.Менеджер)
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_КоличествоЗаявокОт50трДо500тр КАК ВТ_КоличествоЗаявокОт50трДо500тр
		ПО (ДополнительныеНомера.Менеджер = ВТ_КоличествоЗаявокОт50трДо500тр.Менеджер)
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_КоличествоЗаявокОт500тр КАК ВТ_КоличествоЗаявокОт500тр
		ПО (ДополнительныеНомера.Менеджер = ВТ_КоличествоЗаявокОт500тр.Менеджер)
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_КоличествоСуммаЗаявокПоМенеджеруВРаботе КАК ВТ_КоличествоСуммаЗаявокПоМенеджеруВРаботе
		ПО (ДополнительныеНомера.Менеджер = ВТ_КоличествоСуммаЗаявокПоМенеджеруВРаботе.Менеджер)
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_КоличествоСуммаЗаявокПоМенеджеруСобрано КАК ВТ_КоличествоСуммаЗаявокПоМенеджеруСобрано
		ПО (ДополнительныеНомера.Менеджер = ВТ_КоличествоСуммаЗаявокПоМенеджеруСобрано.Менеджер)
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_КоличествоСуммаЗаявокПоМенеджеруОтказ КАК ВТ_КоличествоСуммаЗаявокПоМенеджеруОтказ
		ПО (ДополнительныеНомера.Менеджер = ВТ_КоличествоСуммаЗаявокПоМенеджеруОтказ.Менеджер)
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_КоличествоЗаявокПоМенеджеруВРаботеБолее2д КАК ВТ_КоличествоЗаявокПоМенеджеруВРаботеБолее2д
		ПО (ДополнительныеНомера.Менеджер = ВТ_КоличествоЗаявокПоМенеджеруВРаботеБолее2д.Менеджер)
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_КоличествоЗаявокПоМенеджеруСобраноБолее3д КАК ВТ_КоличествоЗаявокПоМенеджеруСобраноБолее3д
		ПО (ДополнительныеНомера.Менеджер = ВТ_КоличествоЗаявокПоМенеджеруСобраноБолее3д.Менеджер)
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПоступленияДенегСУчетомВозвратов КАК ВТ_ПоступленияДенегСУчетомВозвратов
		ПО (ДополнительныеНомера.Менеджер = ВТ_ПоступленияДенегСУчетомВозвратов.Менеджер)</queryText>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
  </attributes>
  <attributes>
    <name>Период</name>
    <title>
      <key>ru</key>
      <value>Период</value>
    </title>
    <id>3</id>
    <valueType>
      <types>StandardPeriod</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <settingsSavedData xsi:type="form:DataPath">
      <segments>Период</segments>
    </settingsSavedData>
  </attributes>
  <commandInterface>
    <navigationPanel/>
    <commandBar/>
  </commandInterface>
  <extInfo xsi:type="form:ObjectFormExtInfo"/>
