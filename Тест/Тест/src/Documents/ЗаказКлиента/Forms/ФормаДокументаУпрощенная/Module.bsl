Процедура ЗакупленныйТоварЦенаБЕЗНДСПриИзменении(Элемент)
	
	Строка = Элементы.Товары.ТекущиеДанные;
	Если ЗначениеЗаполнено(Объект.Организация) Тогда 
		ПроцентНалог 		= ПолучитьНалогОрганизации(Объект.Организация); 
		Если ПроцентНалог > 0 Тогда 
			Строка.ЦенаСНДС = Строка.Цена + (Строка.Цена * (ПроцентНалог / 100)); 
			Строка.СуммаНДС	= Строка.Цена * (ПроцентНалог/100) * Строка.Количество;
			Строка.Сумма 	= Строка.ЦенаСНДС * Строка.Количество;
		Иначе 
			Строка.ЦенаСНДС		= 0;  
			Строка.СуммаНДС		= 0;
			Строка.Сумма 		= Строка.Цена * Строка.Количество;	 
		КонецЕсли; 
	Иначе 
			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = "Организация не указанна";
			Сообщение.Сообщить();
			Строка.ЦенаСНДС		= 0;  
			Строка.СуммаНДС		= 0;
			Строка.Сумма 		= Строка.Цена * Строка.Количество;	
	КонецЕсли; 
	
	Объект.СуммаДокумента 	=  0; 
	Для Каждого СтрокаТЧ ИЗ Объект.Товары Цикл 
		Если СтрокаТЧ.Отменено <> Истина ТОгда 
			Объект.СуммаДокумента 	= Объект.СуммаДокумента + СтрокаТЧ.Сумма; 	
		КонецЕСли; 	
	КонецЦикла;                                                             
КонецПроцедуры

