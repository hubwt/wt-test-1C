&НаСервере
Процедура СоздатьСчетНаСервере()
	Записать();
	Если НЕ ЗначениеЗаполнено(Объект.Продажа) Тогда
		Возврат;
	КонецЕсли;
	ДокСчет = Документы.ПредварительныйСчет.СоздатьДокумент();
	ДокСчет.Дата = ТекущаяДата();
	ДокСчет.Заполнить(Объект.Продажа);
	ДокСчет.TipOplati = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ТипОплаты, "Счет" );
	Попытка
		
		ДокСчет.Записать(РежимЗаписиДокумента.Проведение);
//		Элементы.СоздатьСчет.Видимость = Ложь;
//		Элементы.ОбновитьСчет.Видимость = Истина;
		
	Исключение
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
		СтрШаблон("Не удалось записать счет. %1",
		ОписаниеОшибки())
		);
		Возврат;	
	КонецПопытки;
	ПредварительныйСчет = ДокСчет.Ссылка;
КонецПроцедуры

