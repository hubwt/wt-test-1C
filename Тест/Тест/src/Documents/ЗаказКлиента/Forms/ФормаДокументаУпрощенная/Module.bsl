	Если ПустаяСтрока(НомерУПД) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Номер УПД не заполнен.";
		Сообщение.Поле = "НомерУПД";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	ТабДокумент = СформироватьУПД(Печать);
