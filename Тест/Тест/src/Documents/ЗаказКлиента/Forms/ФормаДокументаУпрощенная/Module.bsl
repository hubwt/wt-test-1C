&НаКлиенте
Процедура СчетНаОплату(Команда)
	ТабДокумент = СчетНаОплатуНаСервере();
	КоллекцияПечатныхФорм = УправлениеПечатьюКлиент.НоваяКоллекцияПечатныхФорм("СчетНаОплату");
	// Добавляем в коллекцию (тип массив) сформированный Табличный документ
	КоллекцияПечатныхФорм[0].ТабличныйДокумент = ТабДокумент;
	// если требуется устанавливаем параметры печати
	КоллекцияПечатныхФорм[0].Экземпляров=1;
	КоллекцияПечатныхФорм[0].СинонимМакета = "Счет на оплату";  // используется для формирования имени файла при сохранении из общей формы печати документов
	// .. и выводим стандартной процедурой БСП
	УправлениеПечатьюКлиент.ПечатьДокументов(КоллекцияПечатныхФорм,Неопределено,ЭтаФорма);
КонецПроцедуры

Функция СчетНаОплатуНаСервере()
	МассивОбъектов = Новый Массив;
	МассивОбъектов.Добавить(Объект.Продажа);
	ОбъектыПечати = Новый СписокЗначений();
	ТабДок = Документы.ПродажаЗапчастей.ПечатьСчетаЗаказа(МассивОбъектов, ОбъектыПечати);
	Возврат ТабДок;
КонецФункции

Функция СчетНаОплатуСПечатьюНаСервере()
	МассивОбъектов = Новый Массив;
	МассивОбъектов.Добавить(Объект.Продажа);
	ОбъектыПечати = Новый СписокЗначений();
	ТабДок = Документы.ПродажаЗапчастей.ПечатьСчетаЗаказа(МассивОбъектов, ОбъектыПечати, ,,  Истина);
	Возврат ТабДок;
КонецФункции

&НаКлиенте
Процедура СчетНаОплатуСПечатью(Команда)
	ТабДокумент = СчетНаОплатуСПечатьюНаСервере();
	КоллекцияПечатныхФорм = УправлениеПечатьюКлиент.НоваяКоллекцияПечатныхФорм("СчетНаОплату");
	// Добавляем в коллекцию (тип массив) сформированный Табличный документ
	КоллекцияПечатныхФорм[0].ТабличныйДокумент = ТабДокумент;
	// если требуется устанавливаем параметры печати
	КоллекцияПечатныхФорм[0].Экземпляров=1;
	КоллекцияПечатныхФорм[0].СинонимМакета = "Счет на оплату";  // используется для формирования имени файла при сохранении из общей формы печати документов
	// .. и выводим стандартной процедурой БСП
	УправлениеПечатьюКлиент.ПечатьДокументов(КоллекцияПечатныхФорм,Неопределено,ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура Сформировать(Команда)
	
	Объект.Заблокирована = Истина;
	Объект.ДатаБлокировкиЗаявки = ТекущаяДата();
	БлокировкаЗаявкиНаСервере(); 
	Если СтатусДоставки = ПредопределенноеЗначение("Перечисление.СтатусОтправки.Сборка") Тогда
		Сообщить("При статусе отправки ""сборка"" Формирование УПД невозможно!");
	Иначе
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаУПД", ЭтотОбъект);
		
		СтрокаВывода = СтрШаблон("Сформировать номер УПД для организации ""%1"" и клиента ""%2""?", Объект.Организация, Объект.Клиент);
		ПоказатьВопрос(Оповещение, СтрокаВывода, РежимДиалогаВопрос.ДаНет); 
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаУПД(Результат, Параметры) Экспорт
	Если Результат = КодВозвратаДиалога.Да Тогда
		СформироватьУПДНаСервере();
		ПоказатьОповещениеПользователя("УПД сформирован", , "Номер УПД заполнен");
		ЭтотОбъект.Записать();
	Иначе
		Возврат;
	КонецЕсли;
	
	
КонецПроцедуры

&НаСервере
Процедура СформироватьУПДНаСервере()

	Если Не ЗначениеЗаполнено(ДатаУПД) Тогда
		ДатаУПД = ТекущаяДатаСеанса();
	КонецЕсли;

	Если Не ЗначениеЗаполнено(НомерУПД) Или Не дт_Нумерация.НомерУникален(Объект, Истина, Истина, Истина, "НомерУПД") Тогда

		ПрефиксОрганизации = дт_ОбщегоНазначения.ПрефиксОрганизации(Объект.Организация);

		НомерУПД1 = дт_Нумерация.СвободныйНомерДокумента(
		"ПродажаЗапчастей", ДатаУПД, ПрефиксОрганизации, "НомерУПД", Объект.Продажа);

		НомерУПД2 = дт_Нумерация.СвободныйНомерДокумента(
		"ЗаказНаряд", ДатаУПД, ПрефиксОрганизации, "НомерУПД");

		НомерУПД = Макс(НомерУПД1, НомерУПД2);

	КонецЕсли;

КонецПроцедуры

