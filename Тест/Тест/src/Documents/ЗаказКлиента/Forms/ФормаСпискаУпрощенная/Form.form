    </edit>
  </attributes>
  <attributes>
    <name>СписокАкция</name>
    <title>
      <key>ru</key>
      <value>Список акция</value>
    </title>
    <id>3</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	ДокЗаказКлиента.Ссылка КАК Ссылка,
	ДокЗаказКлиента.Номер КАК Номер,
	ДокЗаказКлиента.Клиент КАК Клиент,
	ДокЗаказКлиента.НомерТелефона КАК НомерТелефона,
	ДокЗаказКлиента.Ответственный КАК Ответственный,
	ДокЗаказКлиента.СуммаДокумента КАК СуммаДокумента,
	ВЫБОР
		КОГДА ЕСТЬNULL(ПродажаЗапчастей.Ссылка, НЕОПРЕДЕЛЕНО) &lt;> НЕОПРЕДЕЛЕНО
			ТОГДА &quot;Продажа&quot;
		ИНАЧЕ &quot;Заявка&quot;
	КОНЕЦ КАК ТипСделки,
	НЕОПРЕДЕЛЕНО КАК Поле,
	ДокЗаказКлиента.ЭтапыПродажи КАК ЭтапыПродажи,
	ДокЗаказКлиента.УчаствуетВАкции10 КАК УчаствуетВАкции10,
	ДокЗаказКлиента.Комментарий КАК Комментарий
ПОМЕСТИТЬ ВТ
ИЗ
	Документ.ЗаказКлиента КАК ДокЗаказКлиента
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПродажаЗапчастей КАК ПродажаЗапчастей
		ПО (ПродажаЗапчастей.ЗаказКлиента = ДокЗаказКлиента.Ссылка)
ГДЕ
	ДокЗаказКлиента.Дата МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания
	И ДокЗаказКлиента.УчаствуетВАкции10 = ИСТИНА
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ПредварительныйСчет.Основание КАК Основание,
	МАКСИМУМ(ПредварительныйСчет.Номер) КАК Номер
ПОМЕСТИТЬ ВТ2
ИЗ
	Документ.ПредварительныйСчет КАК ПредварительныйСчет

СГРУППИРОВАТЬ ПО
	ПредварительныйСчет.Основание
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ.Ссылка КАК Ссылка,
	ВТ.Номер КАК Номер,
	ВТ.Клиент КАК Клиент,
	ВТ.НомерТелефона КАК НомерТелефона,
	ВТ.Ответственный КАК Ответственный,
	ВТ.СуммаДокумента КАК СуммаДокумента,
	ВТ.ТипСделки КАК ТипСделки,
	ВТ.Поле КАК Поле,
	ВТ.ЭтапыПродажи КАК ЭтапыПродажи,
	ВТ2.Номер КАК СчетНаОплату,
	ВТ.УчаствуетВАкции10 КАК УчаствуетВАкции10,
	ВТ.Комментарий КАК Комментарий,
	ЗаказКлиента.Ссылка КАК Ссылка1
ИЗ
	ВТ КАК ВТ
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ2 КАК ВТ2
		ПО ВТ.Ссылка = ВТ2.Основание
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказКлиента КАК ЗаказКлиента
		ПО ВТ.Ссылка = ЗаказКлиента.Ссылка</queryText>
      <mainTable>Document.ЗаказКлиента</mainTable>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
  </attributes>
  <attributes>
    <name>ПервыйРаз</name>
