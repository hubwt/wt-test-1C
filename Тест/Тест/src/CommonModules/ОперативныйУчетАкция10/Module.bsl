Функция СписокТоваровАкция10() ЭКСПОРТ
	//==================================================================================================================
	ТЗ_Товары = Новый ТаблицаЗначений(); 
	ТЗ_Фото	  = Новый ТаблицаЗначений(); 
	ТЗ_КодНоменкл = Новый Массив(); 
	МассивТоваров = Новый Массив();
	
	//==================================================================================================================
	ТЗ_Товары 	= СписокТоваров();
	Если НЕ ТЗ_Товары.Количество() > 0 ТОгда 
		СтруктураТоваров = Новый Структура;
		СтруктураТоваров.Вставить("error"	,404);
		Возврат СтруктураТоваров; 
	КонецЕсли; 

	ТЗ_КодНоменкл = ТЗ_Товары.ВыгрузитьКолонку("Код");
	ТЗ_Фото = РаботаССайтомWT.ПолучениеФотокарточек(ТЗ_КодНоменкл);
	
	//==================================================================================================================
	Для Каждого стр Из ТЗ_Товары Цикл
		Для Каждого Строка Из ТЗ_Фото Цикл
			Если Строка.id = стр.Код Тогда
				Структура = Новый Структура;
				Если Строка.images.main <> "" Тогда
					СтруктураТоваров = Новый Структура;
					СтруктураТоваров.Вставить("cardId"		,стр.Код );
					СтруктураТоваров.Вставить("photo"		,Строка.images.main);
					СтруктураТоваров.Вставить("name"		,стр.Товар);
					СтруктураТоваров.Вставить("article"		,стр.Артикул);
					СтруктураТоваров.Вставить("count"		,стр.КолвоОстаток);
					СтруктураТоваров.Вставить("price"		,стр.ЦенаРекОстаток);
					СтруктураТоваров.Вставить("salePrice"	,стр.ЦенаОстаток);
					СтруктураТоваров.Вставить("all"			,стр.КолвоОстаток + стр.ПроданноКоличество);
					МассивТоваров.Добавить(СтруктураТоваров);
					Прервать;
				Иначе
					Если Строка.images.common.Количество() > 0 Тогда
						СтруктураТоваров = Новый Структура;
						СтруктураТоваров.Вставить("cardId"		,стр.Код );
						СтруктураТоваров.Вставить("photo"		,Строка.images.common[0]);
						СтруктураТоваров.Вставить("name"		,стр.Товар);
						СтруктураТоваров.Вставить("article"		,стр.Артикул);
						СтруктураТоваров.Вставить("count"		,стр.КолвоОстаток);
						СтруктураТоваров.Вставить("price"		,стр.ЦенаРекОстаток);
						СтруктураТоваров.Вставить("salePrice"	,стр.ЦенаОстаток);
						СтруктураТоваров.Вставить("all"			,стр.КолвоОстаток + стр.ПроданноКоличество);
						МассивТоваров.Добавить(СтруктураТоваров);
						Прервать;	
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Если МассивТоваров.Количество() > 0 Тогда 
		Возврат МассивТоваров; 
	Иначе 
		СтруктураТоваров = Новый Структура;
		СтруктураТоваров.Вставить("error"	,404);
		Возврат СтруктураТоваров; 
	КонецЕсли; 
	
	//===================================================================================================================
КонецФункции

Функция СписокТоваров() 
	
	ТЗ_ПроданныеТовары  = Новый ТаблицаЗначений();
	ТЗ_Товары			= Новый ТаблицаЗначений();
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	РегистрАкция10Остатки.Товар.Наименование КАК Товар,
		|	РегистрАкция10Остатки.КолвоОстаток КАК КолвоОстаток,
		|	РегистрАкция10Остатки.ЦенаОстаток КАК ЦенаОстаток,
		|	РегистрАкция10Остатки.Товар.Код КАК Код,
		|	РегистрАкция10Остатки.Товар.Артикул КАК Артикул,
		|	РегистрАкция10Остатки.ЦенаРекОстаток КАК ЦенаРекОстаток,
		|	РегистрАкция10Остатки.индкод КАК индкод
		|ПОМЕСТИТЬ ВТ_1
		|ИЗ
		|	РегистрНакопления.РегистрАкция10.Остатки КАК РегистрАкция10Остатки
		|ГДЕ
		|	РегистрАкция10Остатки.КолвоОстаток > 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_1.Товар КАК Товар,
		|	ВТ_1.Код КАК Код,
		|	ВТ_1.Артикул КАК Артикул,
		|	МИНИМУМ(ВТ_1.ЦенаРекОстаток) КАК ЦенаРекОстаток,
		|	СУММА(ВТ_1.КолвоОстаток) КАК КолвоОстаток, 
		|	МИНИМУМ(ВТ_1.ЦенаОстаток) КАК ЦенаОстаток,
		|	0 КАК ПроданноКоличество
		|ИЗ
		|	ВТ_1 КАК ВТ_1
		|СГРУППИРОВАТЬ ПО
		|	ВТ_1.Товар,
		|	ВТ_1.Код,
		|	ВТ_1.Артикул
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЦенаОстаток УБЫВ";
	
	
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда 
		ТЗ_Товары = РезультатЗапроса.Выгрузить(); 
	КонецЕсли; 
	
	//==================================================================================================================
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	РегистрАкция10ОстаткиИОбороты.индкод КАК индкод,
		|	РегистрАкция10ОстаткиИОбороты.КолвоРасход КАК КолвоРасход,
		|	РегистрАкция10ОстаткиИОбороты.Товар.Артикул КАК Артикул,
		|	РегистрАкция10ОстаткиИОбороты.Товар.Наименование КАК Товар,
		|	РегистрАкция10ОстаткиИОбороты.Товар.Код КАК ТоварКод,
		|	РегистрАкция10ОстаткиИОбороты.ЦенаРасход КАК ЦенаРасход,
		|	РегистрАкция10ОстаткиИОбороты.ЦенаРекРасход КАК ЦенаРекРасход
		|ПОМЕСТИТЬ ВТ_1
		|ИЗ
		|	РегистрНакопления.РегистрАкция10.ОстаткиИОбороты(&Дата1, &Дата2, День,,) КАК РегистрАкция10ОстаткиИОбороты
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЗаходАкция10Товары.Партия КАК Партия,
		|	ЗаходАкция10Товары.ЦенаАкция КАК ЦенаАкция,
		|	ЗаходАкция10Товары.ЦенаРек КАК ЦенаРек
		|ПОМЕСТИТЬ ВТ_2
		|ИЗ
		|	Документ.ЗаходАкция10.Товары КАК ЗаходАкция10Товары
		|ГДЕ
		|	ЗаходАкция10Товары.Ссылка.ПометкаУдаления = ЛОЖЬ
		|	И ЗаходАкция10Товары.Ссылка.ДатаАкции = &ДатаАкции
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_1.Товар КАК Товар,
		|	ВТ_1.ТоварКод КАК Код,
		|	ВТ_1.Артикул КАК Артикул,
		|	ЕСТЬNULL(МИНИМУМ(ВТ_2.ЦенаРек),0) КАК ЦенаРекОстаток,
		|	0 КАК КолвоОстаток,
		|	ЕСТЬNULL(МИНИМУМ(ВТ_2.ЦенаАкция),0) КАК ЦенаОстаток,
		|	ЕСТЬNULL(СУММА(ВТ_1.КолвоРасход),0) КАК ПроданноКоличество
		|ИЗ
		|	ВТ_1 КАК ВТ_1
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_2 КАК ВТ_2
		|		ПО (ВТ_1.индкод = ВТ_2.Партия)
		|СГРУППИРОВАТЬ ПО
		|	ВТ_1.Товар,
		|	ВТ_1.ТоварКод,
		|	ВТ_1.Артикул
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЦенаОстаток УБЫВ";
	
	Запрос.УстановитьПараметр("Дата1", НачалоДня			(ТекущаяДатаСеанса()));
	Запрос.УстановитьПараметр("Дата2", КонецДня				(ТекущаяДатаСеанса()));
	Запрос.УстановитьПараметр("ДатаАкции", НачалоДня		(ТекущаяДатаСеанса()));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда 
		ТЗ_ПроданныеТовары = РезультатЗапроса.Выгрузить(); 
		
			Для каждого Строка ИЗ ТЗ_ПроданныеТовары Цикл 
		
			НайденнаяСтрока = ТЗ_Товары.Найти(Строка(Строка.Товар) ,"Товар");	
			Если НайденнаяСтрока <> Неопределено Тогда
	        	
	        	НайденнаяСтрока.ПроданноКоличество = Строка.ПроданноКоличество; 
	        	
			Иначе 
				НовыяСтрока = ТЗ_Товары.Добавить(); 
				ЗаполнитьЗначенияСвойств(НовыяСтрока,Строка);
	    	КонецЕсли;	
			
			КонецЦикла; 
	КонецЕсли; 
	
	Возврат ТЗ_Товары; 
	//==================================================================================================================
	
КонецФункции	

Функция ПолучитьТоварыКарточкиАкция10(КодТовара) ЭКСПОРТ
	//==================================================================================================================
	ТЗ_Товары 		 = Новый ТаблицаЗначений(); 
	ТЗ_Фото	  		 = Новый ТаблицаЗначений(); 
	ТЗ_Фото_Карточек = Новый ТаблицаЗначений(); 
	ТЗ_ИндКод		 = Новый Массив(); 
	МассивТоваров 	 = Новый Массив();
	Массив			 = Новый Массив();
	
	//===================================================================================================================
	ТЗ_Товары 	= СписокТоваровКарточки(КодТовара);
	Если  НЕ ЗначениеЗаполнено(ТЗ_Товары) ТОгда 
		СтруктураТоваров = Новый Структура;
		СтруктураТоваров.Вставить("error"	,404);
		Возврат СтруктураТоваров; 
	КонецЕсли; 
	
	ТЗ_ИндКод 		= ТЗ_Товары.ВыгрузитьКолонку("индкод");
	ТЗ_Фото 		= РаботаССайтомWT.ПолучениеФотоБезИндНомер(ТЗ_ИндКод);
	Массив.Добавить(КодТовара);
	ТЗ_Фото_Карточки = РаботаССайтомWT.ПолучениеФотокарточек(Массив);
	
	//===================================================================================================================
	Для Каждого стр Из ТЗ_Товары Цикл
		
		Для Каждого Строка Из ТЗ_Фото Цикл
			Если Строка.indCode = стр.индкод Тогда
				Если Строка.urls.Количество() > 0 Тогда
					МассивФото = Новый Массив();
					Счетчик = 0; 
					Флаг = Ложь;
					Для Каждого СтрокаУрл ИЗ Строка.urls Цикл
						МассивФото.Добавить(СтрокаУрл);
						Счетчик = Счетчик + 1 ;
						Флаг = Истина; 
						Если Счетчик = 2 Тогда 
							Прервать;
						КонецЕсли; 
					КонецЦикла; 
					
					Если Флаг = Истина Тогда 
						СтруктураТоваров = Новый Структура;
						СтруктураТоваров.Вставить("name"	,стр.Товар);
						СтруктураТоваров.Вставить("article"	,стр.Артикул);
						СтруктураТоваров.Вставить("photo"	,МассивФото);
						СтруктураТоваров.Вставить("tovId"	,стр.индкод);
						СтруктураТоваров.Вставить("price"	,стр.ЦенаОстаток);
						СтруктураТоваров.Вставить("sold"	,стр.ПроданноКоличество);
						МассивТоваров.Добавить(СтруктураТоваров);
						Прервать;
						
					КонецЕсли; 
				Иначе 
					Для Каждого Строка1 Из ТЗ_Фото_Карточки Цикл
						Если Строка1.images.main <> "" Тогда
							МассивФото = Новый Массив();
							МассивФото.Добавить(Строка1.images.main);
							СтруктураТоваров = Новый Структура;
							СтруктураТоваров.Вставить("name"	,стр.Товар);
							СтруктураТоваров.Вставить("article"	,стр.Артикул);
							СтруктураТоваров.Вставить("photo"	,МассивФото);
							СтруктураТоваров.Вставить("tovId"	,стр.индкод);
							СтруктураТоваров.Вставить("price"	,стр.ЦенаОстаток);
							СтруктураТоваров.Вставить("sold"	,стр.ПроданноКоличество);
							МассивТоваров.Добавить(СтруктураТоваров);
							Прервать;
						Иначе
							Если Строка1.images.common.Количество() > 0 Тогда
								СтруктураТоваров = Новый Структура;
								МассивФото = Новый Массив();
								МассивФото.Вставить(Строка1.images.common[0]);
								СтруктураТоваров.Вставить("name"	,стр.Товар);
								СтруктураТоваров.Вставить("article"	,стр.Артикул);
								СтруктураТоваров.Вставить("photo"	,МассивФото);
								СтруктураТоваров.Вставить("tovId"	,стр.индкод);
								СтруктураТоваров.Вставить("price"	,стр.ЦенаОстаток);
								СтруктураТоваров.Вставить("sold"	,стр.ПроданноКоличество);
								МассивТоваров.Добавить(СтруктураТоваров);
								Прервать;	
							КонецЕсли;
						КонецЕсли;
					КонецЦикла;
				//=======================================================================================================	
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Если ЗначениеЗаполнено(МассивТоваров) Тогда 
		Возврат МассивТоваров; 
	Иначе 
		
		СтруктураТоваров = Новый Структура;
		СтруктураТоваров.Вставить("error"	,404);
		Возврат СтруктураТоваров; 
		
	КонецЕсли; 
	
	//==================================================================================================================
КонецФункции

