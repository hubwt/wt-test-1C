Функция ПолучитьТоварыАкция10(count,page) ЭКСПОРТ //(КодТовара)
	
	//==================================================================================================================
	ТЗ_Товары 		 = Новый ТаблицаЗначений(); 
	ТЗ_Фото	  		 = Новый ТаблицаЗначений(); 
	ТЗ_Фото_Карточек = Новый ТаблицаЗначений(); 
	Массив_ИндКод	 = Новый Массив(); 
	МассивТоваров 	 = Новый Массив();
	Массив_Кодов	 = Новый Массив();
	СтраницВсего     = Новый Структура; 
	//====================================================================================================================
	
	СтрукткраОтвета = СписокТоваров(count,page); 
	Если СтрукткраОтвета = Неопределено Тогда 
		СтруктураТоваров = Новый Структура;
		СтруктураТоваров.Вставить("error"	,6666);
		Возврат СтруктураТоваров; 
	КонецЕсли; 
	
	ТЗ_Товары =  СтрукткраОтвета.МассивТовары;
	СтраницВсего.Вставить("allPages", СтрукткраОтвета.СтраницВсего); 
	МассивТоваров.Добавить(СтраницВсего); 
	
	Если ТЗ_Товары.Количество() < 1  Тогда 
		СтруктураТоваров = Новый Структура;
		СтруктураТоваров.Вставить("error"	,7777);
		Возврат СтруктураТоваров; 
	КонецЕсли;
	
	Массив_ИндКод 	= ТЗ_Товары.ВыгрузитьКолонку("индкод");
	Массив_Кодов	= ТЗ_Товары.ВыгрузитьКолонку("Код");
	//=====================================================================================================================
	ТЗ_Фото 		= РаботаССайтомWT.ПолучениеФотоБезИндНомер(Массив_ИндКод);
	ТЗ_Фото_Карточки = РаботаССайтомWT.ПолучениеФотокарточек(Массив_Кодов);
	//====================================================================================================================
	Для Каждого стр Из ТЗ_Товары Цикл
		
		Для Каждого Строка Из ТЗ_Фото Цикл
			Если Строка.indCode = стр.индкод Тогда
				Если Строка.urls.Количество() > 0 Тогда
					МассивФото = Новый Массив();
					Счетчик = 0; 
					Флаг = Ложь;
					Для Каждого СтрокаУрл ИЗ Строка.urls Цикл
						МассивФото.Добавить(СтрокаУрл);
						Счетчик = Счетчик + 1 ;
						Флаг = Истина; 
						Если Счетчик = 2 Тогда 
							Прервать;
						КонецЕсли; 
					КонецЦикла; 
					
					Если Флаг = Истина Тогда 
						СтруктураТоваров = Новый Структура;
						СтруктураТоваров.Вставить("name"	 ,стр.Товар);
						СтруктураТоваров.Вставить("article"	 ,стр.Артикул);
						СтруктураТоваров.Вставить("photo"	 ,МассивФото);
						СтруктураТоваров.Вставить("tovId"	 ,стр.индкод);
						СтруктураТоваров.Вставить("salePrice",стр.ЦенаОстаток);
						СтруктураТоваров.Вставить("price"    ,стр.ЦенаРекОстаток);
						СтруктураТоваров.Вставить("sold"	 ,стр.ПроданноКоличество);
						
						Если стр.НомерТелефона = "     " Тогда 
							СтруктураТоваров.Вставить("phoneClients",""); 
						ИНаче 
							СтруктураТоваров.Вставить("phoneClients",стр.НомерТелефона); 
						КонецЕсли; 
						
						МассивТоваров.Добавить(СтруктураТоваров);
						Прервать;
						
					КонецЕсли; 
				Иначе 
					Для Каждого Строка1 Из ТЗ_Фото_Карточки Цикл
						Если Строка1.images.main <> "" Тогда
							МассивФото = Новый Массив();
							МассивФото.Добавить(Строка1.images.main);
							СтруктураТоваров = Новый Структура;
							СтруктураТоваров.Вставить("name"	 ,стр.Товар);
							СтруктураТоваров.Вставить("article"	 ,стр.Артикул);
							СтруктураТоваров.Вставить("photo"	 ,МассивФото);
							СтруктураТоваров.Вставить("tovId"	 ,стр.индкод);
							СтруктураТоваров.Вставить("salePrice",стр.ЦенаОстаток);
							СтруктураТоваров.Вставить("price"	 ,стр.ЦенаРекОстаток);
							СтруктураТоваров.Вставить("sold"	 ,стр.ПроданноКоличество);
							
							Если стр.НомерТелефона = "     " Тогда 
								СтруктураТоваров.Вставить("phoneClients",""); 
							ИНаче 
								СтруктураТоваров.Вставить("phoneClients",стр.НомерТелефона); 
							КонецЕсли;
							
							МассивТоваров.Добавить(СтруктураТоваров);
							Прервать;
						Иначе
							Если Строка1.images.common.Количество() > 0 Тогда
								СтруктураТоваров = Новый Структура;
								МассивФото = Новый Массив();
								МассивФото.Добавить(Строка1.images.common[0]);
								СтруктураТоваров.Вставить("name"	 ,стр.Товар);
								СтруктураТоваров.Вставить("article"	 ,стр.Артикул);
								СтруктураТоваров.Вставить("photo"	 ,МассивФото);
								СтруктураТоваров.Вставить("tovId"	 ,стр.индкод);
								СтруктураТоваров.Вставить("salePrice",стр.ЦенаОстаток);
								СтруктураТоваров.Вставить("price"    ,стр.ЦенаРекОстаток);
								СтруктураТоваров.Вставить("sold"	 ,стр.ПроданноКоличество);
								
								Если стр.НомерТелефона = "     " Тогда 
									СтруктураТоваров.Вставить("phoneClients",""); 
								ИНаче 
									СтруктураТоваров.Вставить("phoneClients",стр.НомерТелефона); 
								КонецЕсли;
								
								МассивТоваров.Добавить(СтруктураТоваров);
								Прервать;	
							КонецЕсли;
						КонецЕсли;
					КонецЦикла;
				//=======================================================================================================	
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Если ЗначениеЗаполнено(МассивТоваров) Тогда 
		Возврат МассивТоваров; 
	Иначе 
		
		СтруктураТоваров = Новый Структура;
		СтруктураТоваров.Вставить("error"	,1313);
		Возврат СтруктураТоваров; 
		
	КонецЕсли; 
	
	//==================================================================================================================
КонецФункции

Функция СписокТоваров(Количество,Страница) 
	
//======================================================================================================================

	ТЗ_ПроданныеТовары  = Новый ТаблицаЗначений();
	ТЗ_Товары			= Новый ТаблицаЗначений();
	
	ТЗ_Товары_2 = Новый  ТаблицаЗначений(); 
	ТЗ_Товары_2.Колонки.Добавить("Товар"); 
	ТЗ_Товары_2.Колонки.Добавить("Код"); 
	ТЗ_Товары_2.Колонки.Добавить("Артикул"); 
	ТЗ_Товары_2.Колонки.Добавить("ЦенаРекОстаток"); 
	ТЗ_Товары_2.Колонки.Добавить("КолвоОстаток"); 
	ТЗ_Товары_2.Колонки.Добавить("ЦенаОстаток"); 
	ТЗ_Товары_2.Колонки.Добавить("ПроданноКоличество"); 
	ТЗ_Товары_2.Колонки.Добавить("НомерТелефона"); 
	ТЗ_Товары_2.Колонки.Добавить("индкод");
	
	count = 0;
	page = 0; 
    КоличествоВсего = 0;
	СтраницВсего = 0; 
	Остаток = 0;
	Начало = 0;
	Конец =  0;
	
	СтрукткраОтвета = Новый Структура; 
//=========================================================================================================	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	РегистрАкция10Остатки.Товар.Наименование КАК Товар,
		|	РегистрАкция10Остатки.КолвоОстаток КАК КолвоОстаток,
		|	РегистрАкция10Остатки.ЦенаОстаток КАК ЦенаОстаток,
		|	РегистрАкция10Остатки.Товар.Код КАК Код,
		|	РегистрАкция10Остатки.Товар.Артикул КАК Артикул,
		|	РегистрАкция10Остатки.ЦенаРекОстаток КАК ЦенаРекОстаток,
