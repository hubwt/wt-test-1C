		|		ПО (ЗаказКлиентаТовары.Партия.Наименование = ВТ_1.индкод)
		|			И (ЗаказКлиентаТовары.Ссылка.НомерТелефонаАкция10 <> """")
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЦенаОстаток УБЫВ";
	
	Запрос.УстановитьПараметр("Дата1", НачалоДня(ТекущаяДатаСеанса()));
	Запрос.УстановитьПараметр("Дата2", КонецДня(ТекущаяДатаСеанса()));
	РезультатЗапроса = Запрос.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда 
		ТЗ_ПроданныеТовары = РезультатЗапроса.Выгрузить(); 
			Для каждого Строка ИЗ ТЗ_ПроданныеТовары Цикл 
				ЕСли ТЗ_Товары.Количество() > 0 Тогда  
					НайденнаяСтрока = ТЗ_Товары.Найти(Строка(Строка.индкод) ,"индкод");	
					Если НайденнаяСтрока <> Неопределено Тогда   	 	
					Иначе 
						НовыяСтрока = ТЗ_Товары.Добавить();
						НовыяСтрока.НомерТелефона  =  Прав(СтрЗаменить(Строка.НомерТелефона2," ",""), 5);
						ЗаполнитьЗначенияСвойств(НовыяСтрока,Строка);
			    	КонецЕсли;	
				Иначе
					 ТЗ_Товары = ТЗ_ПроданныеТовары;
				КонецЕсли; 
			КонецЦикла; 
	КонецЕсли; 
	
//	Возврат ТЗ_Товары; 
	//================================================================================================================================
	ТЗ_Товары.Сортировать("ЦенаОстаток УБЫВ"); 
	
	КоличествоВсего = ТЗ_Товары.Количество();
	СтраницВсего = Цел(КоличествоВсего / Количество); 
	Остаток = КоличествоВсего % Количество;
	Если Остаток > 0 Тогда 
		СтраницВсего = СтраницВсего + 1;	
	КонецЕСли; 
	
	Начало = Количество * (Страница - 1) + 1;
	Конец	=  Начало +  Количество - 1;
	
	Счетчик = 1; 
	Для каждого Строка ИЗ ТЗ_Товары Цикл 
		Если Счетчик >= Начало И Счетчик <= Конец  Тогда 
			НовыяСтрока = ТЗ_Товары_2.Добавить();
			ЗаполнитьЗначенияСвойств(НовыяСтрока,Строка); 
		КонецЕСли;                                        
		Счетчик = Счетчик + 1;
	КонецЦикла; 
	
	Если ЗначениеЗаполнено(ТЗ_Товары_2) Тогда 
		СтрукткраОтвета.Вставить("МассивТовары",ТЗ_Товары_2); 
		СтрукткраОтвета.Вставить("СтраницВсего",СтраницВсего);
		Возврат СтрукткраОтвета;  
	Иначе 
		Возврат Неопределено; 
	КонецЕСли; 
	
