// ++++ Получить текущий этап заявки 
Функция ПолучитьТекущийЭтапЗаявки(НомерЗаявки) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ЗаказКлиента.ЭтапыПродажи
		|ИЗ
		|	Документ.ЗаказКлиента КАК ЗаказКлиента
		|ГДЕ
		|	ЗаказКлиента.Ссылка.Номер = &Номер";
	
	Запрос.УстановитьПараметр("Номер", НомерЗаявки);
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() тогда 		
		Возврат Неопределено;
	КонецЕсли; 
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();
	Этап = Выборка.ЭтапыПродажи; 
		
Возврат Этап; 
КонецФункции 
