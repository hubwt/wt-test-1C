// Продажа МодульФормы
//&НаСервереБезКонтекста // Процедура вызывается из ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
Процедура СинхронизоватьВыданСЗаказомКлиента(СсылкаЗаказКлиента,НомерПродажа) ЭКСПОРТ
	
	Если НЕ ЗначениеЗаполнено(СсылкаЗаказКлиента) тогда 
		Возврат;
	Конецесли; 	

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ПродажаЗапчастейТаблица.НомерСтроки,
		|	ПродажаЗапчастейТаблица.Ссылка,
		|	ПродажаЗапчастейТаблица.Товар,
		|	ПродажаЗапчастейТаблица.Количество,
		|	ПродажаЗапчастейТаблица.Цена,
		|	ПродажаЗапчастейТаблица.Скидка,
		|	ПродажаЗапчастейТаблица.Партия,
		|	ПродажаЗапчастейТаблица.машина,
		|	ПродажаЗапчастейТаблица.цена1,
		|	ПродажаЗапчастейТаблица.Комментарий,
		|	ПродажаЗапчастейТаблица.Сумма,
		|	ПродажаЗапчастейТаблица.ПродНак,
		|	ПродажаЗапчастейТаблица.укод,
		|	ПродажаЗапчастейТаблица.Отменено,
		|	ПродажаЗапчастейТаблица.Склад,
		|	ПродажаЗапчастейТаблица.СуммаНДС,
		|	ПродажаЗапчастейТаблица.СтатусТовара,
		|	ПродажаЗапчастейТаблица.ДатаОтгрузкиСоСклада,
		|	ПродажаЗапчастейТаблица.Сборщик,
		|	ПродажаЗапчастейТаблица.ДатаВыдачи,
		|	ПродажаЗапчастейТаблица.ОтветственныйЗаВыдачу,
		|	ПродажаЗапчастейТаблица.Корректировка,
		|	ПродажаЗапчастейТаблица.МестоХранения,
		|	ПродажаЗапчастейТаблица.Заменить
		|ИЗ
		|	Документ.ПродажаЗапчастей.Таблица КАК ПродажаЗапчастейТаблица
		|ГДЕ
		|	
		|	ПродажаЗапчастейТаблица.Ссылка.Номер = &Номер";
	
	Запрос.УстановитьПараметр("Номер",НомерПродажа);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если  РезультатЗапроса.Пустой() ТОгда 
		Возврат; 
	КонецЕСли ;
	
	Попытка
	ОбъектЗаказКлиента = СсылкаЗаказКлиента.ПолучитьОбъект(); 
	ОбъектЗаказКлиента.Товары.Очистить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ОбъектЗаказКлиента.Товары.Добавить();
		НоваяСтрока.Номенклатура = Выборка.Товар;
		НоваяСтрока.Партия 		= Выборка.Партия;
		НоваяСтрока.Выдан 		= Выборка.СтатусТовара;
		НоваяСтрока.Количество 	= Выборка.Количество;
		НоваяСтрока.Цена 		= Выборка.Цена;
		НоваяСтрока.Сумма 		= Выборка.Сумма;
		НоваяСтрока.Отменено	= Выборка.Отменено; 
		НоваяСтрока.ОтветственныйЗаВыдачу 	= Выборка.ОтветственныйЗаВыдачу; 
		НоваяСтрока.ДатаВыдачи				= Выборка.ДатаВыдачи;
		НоваяСтрока.Заменить				= Выборка.Заменить; 
	КонецЦикла;
	
// ----------------------------------------------------------------------------------------------------------------
	
	ОбъектЗаказКлиента.Записать();	
	Исключение
		
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Ошибка!!! не получилось синхронизовать заявку. Пишите в тех поддержку! Код Ошибки: 014553"; 
		Сообщение.Сообщить();
		
	КонецПопытки; 
КонецПроцедуры
